<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Ensure Data Source matches your SSMS Server Name (.\SQLEXPRESS) -->
    <add name="MyDbConn" 
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=APBBroadband;Integrated Security=True" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
</configuration>